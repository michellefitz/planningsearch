{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run seed && npm run db:static --workspace server",
  "outputDirectory": "web/dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "server/{data,dist}/**"
    }
  }
}
